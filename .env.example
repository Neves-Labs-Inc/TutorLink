# Copy to .env before the first `docker compose up`. Never commit .env.
# Migrations are applied explicitly, never on startup:
#   docker compose run --rm api alembic upgrade head

# App
DATABASE_URL=postgresql+psycopg://tutorlink:tutorlink@postgres:5432/tutorlink
# SECRET_KEY must be replaced: the app refuses to start on this placeholder,
# or on any key shorter than 32 bytes. Generate one with `openssl rand -hex 32`.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Must stay true for any deployment reachable over the network. Set to false
# only for local plain-HTTP development, where a browser would refuse to
# store a Secure cookie at all.
COOKIE_SECURE=true
# Optional. An IANA timezone name such as America/New_York; defaults to UTC. It sets the zone
# that bot dates, slot lead times, booking windows and "upcoming" use.
# BUSINESS_TIMEZONE=UTC
# Comma-separated IP addresses and/or CIDR blocks of the reverse proxies whose
# X-Forwarded-For and X-Forwarded-Proto headers this API may believe. Empty means
# trust nothing: the client address is the socket peer, which is correct when the API
# is reached directly and collapses every user into one rate-limit bucket behind a
# proxy. A hostname does not work — trust is matched against the peer's address and
# nothing resolves a name. `*`, 0.0.0.0/0 and ::/0 are refused at startup: they trust
# the header from any peer and make the per-IP login limit meaningless.
TRUSTED_PROXIES=
# Production only: set false to keep /docs, /redoc and /openapi.json off the public origin.
# API_DOCS_ENABLED=true

# WhatsApp bot (Phase 7). Expose your local webhook to Twilio with ngrok — see
# Readme.md:147-153 for the command and where to paste the resulting URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Where Twilio POSTs delivery status updates for messages sent via the REST API
# (admin socket messages, not bot replies — those are TwiML and carry no SID).
TWILIO_STATUS_CALLBACK_URL=
# The bot refuses to run without this; the app still boots with it unset.
ANTHROPIC_API_KEY=

# Postgres (container)
POSTGRES_USER=tutorlink
POSTGRES_PASSWORD=tutorlink
POSTGRES_DB=tutorlink

# Dashboard (Vite)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://api:8000
