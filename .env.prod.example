# The production variable set. This file is documentation, not a secret: it lists every name the
# production stack reads, a placeholder value, and where the real value comes from.
#
# The real /opt/tutorlink/.env is GENERATED ON THE BOX at deploy time from SSM Parameter Store,
# 0600 and root:root, and is never committed. Anything marked SSM below is a SecureString at
# /tutorlink/prod/<NAME>; everything else is a literal the deploy writes as it stands here.
#
# Keep this file in step with .env.example. A variable that exists in docker-compose.yml and not
# here is a production stack that boots missing something — the bot with no ANTHROPIC_API_KEY is
# the one that fails silently: the container starts, health checks pass, the dashboard works,
# and the first parent who messages gets nothing.

# --- Image selection (read by docker-compose.prod.yml) ---------------------------------------
# The ECR registry host, e.g. 123456789012.dkr.ecr.eu-west-1.amazonaws.com. The deploy writes
# IMAGE_TAG from its own argument: /opt/tutorlink/deploy.sh <image-tag>.
ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
IMAGE_TAG=latest

# --- Caddy / the single origin ---------------------------------------------------------------
# The production hostname. Blocked on #34 — nothing else in Phase 8 waits on it, but the
# certificate, this site block and the Twilio webhook URL all key on this name.
DOMAIN=tutorlink.example.com
# Let's Encrypt registration address: where expiry and problem notices are sent.
ACME_EMAIL=ops@example.com

# --- App -------------------------------------------------------------------------------------
# SSM (/tutorlink/prod/DATABASE_URL) because it embeds POSTGRES_PASSWORD. Host is the compose
# service name; Postgres publishes no port in production.
DATABASE_URL=postgresql+psycopg://tutorlink:<password>@postgres:5432/tutorlink
REDIS_URL=redis://redis:6379/0
# SSM (/tutorlink/prod/SECRET_KEY). Generate with `openssl rand -hex 32`. The app refuses to
# start on the .env.example placeholder or on anything shorter than 32 bytes.
SECRET_KEY=<ssm:/tutorlink/prod/SECRET_KEY>
# Stated explicitly even though it already defaults true: the box is network-reachable and every
# request reaches it over HTTPS.
COOKIE_SECURE=true
# REQ-083, and this single line is the whole of it. Caddy's pinned address on the compose
# network declared in docker-compose.prod.yml (172.28.0.0/24). The API believes
# X-Forwarded-For and X-Forwarded-Proto from this peer and no other, which is what keeps the
# per-IP login bucket keyed on the real client and makes request.url.scheme read `https` for
# Twilio's signature check.
#
# Change this and the overlay's `ipam` subnet together. The subnet itself (172.28.0.0/24) is an
# acceptable value if the fixed address is ever dropped, but it trusts every container on the
# network rather than only Caddy. A hostname does NOT work and is refused at startup, as are
# `*`, 0.0.0.0/0 and ::/0.
TRUSTED_PROXIES=172.28.0.10

# --- WhatsApp bot ----------------------------------------------------------------------------
# SSM (/tutorlink/prod/TWILIO_ACCOUNT_SID) and (/tutorlink/prod/TWILIO_AUTH_TOKEN).
TWILIO_ACCOUNT_SID=<ssm:/tutorlink/prod/TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<ssm:/tutorlink/prod/TWILIO_AUTH_TOKEN>
# Not a secret; the WhatsApp sender in E.164, e.g. whatsapp:+441234567890.
TWILIO_WHATSAPP_NUMBER=
# Where Twilio POSTs delivery status for messages sent via the REST API. Placeholder until #34
# settles the domain — it must then be https://<DOMAIN>/webhook/whatsapp/status, and /webhook/*
# is routed to the API by docker/Caddyfile.
TWILIO_STATUS_CALLBACK_URL=https://tutorlink.example.com/webhook/whatsapp/status
# SSM (/tutorlink/prod/ANTHROPIC_API_KEY). The bot refuses to run without it; the app still
# boots with it unset, which is why its absence is silent until a parent messages.
ANTHROPIC_API_KEY=<ssm:/tutorlink/prod/ANTHROPIC_API_KEY>

# --- Postgres (container) --------------------------------------------------------------------
POSTGRES_USER=tutorlink
# SSM (/tutorlink/prod/POSTGRES_PASSWORD). Must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=<ssm:/tutorlink/prod/POSTGRES_PASSWORD>
POSTGRES_DB=tutorlink

# --- Backups (read by deploy/backup.sh and deploy/restore-test.sh, not by Compose) ------------
# The versioned S3 bucket the nightly pg_dump uploads to, under
# postgres/YYYY/MM/tutorlink-<UTC ISO8601>.dump. Not a secret — a bucket name — but REQ-084 gates
# the phase on it: without it the backup scripts fail and nothing else looks wrong, so a box can
# run for months with no recoverable copy of the agency's data.
BACKUP_BUCKET=tutorlink-prod-backups

# --- Dashboard (Vite) ------------------------------------------------------------------------
# Build-time only: baked into the bundle by `npm run build` on the CI runner, never read on the
# box. Empty is the production value — the dashboard is same-origin behind Caddy, which is the
# point of the single-origin topology. There is deliberately no VITE_API_PROXY_TARGET: that is a
# dev-server setting and the production bundle has no dev server.
VITE_API_BASE_URL=
